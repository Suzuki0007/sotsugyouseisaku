    speakerName: 
    text: "(\u9418\u304C\u9CF4\u308C\u3070\u9858\u3044\u304C\u53F6\u3046\u5CF6\u3002\u3067\u3082\u3001\u884C\u3063\u3066\u5E30\u3063\u3066\u304D\u305F\u4EBA\u306F\u3044\u306A\u3044)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "(\u305D\u308C\u3067\u3082\u3001\u884C\u304F\u3057\u304B\u306A\u3044)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
