    speakerName: 
    text: "\u5149\u3063\u305F\u3001\u3001\uFF01"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 5
    speakerName: 
    text: "(\u3067\u3082\u3001\u958B\u304B\u306A\u3044\u3001\u3001)"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u4E0A\u306E\u30E9\u30F3\u30D7\u30012\u3064\u3068\u3082\u4E00\u77AC\u3064\u3044\u305F\u306A\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "(\u30E9\u30F3\u30D7\u304B\u3089\u3001\u7BA1\u304C\u5DE6\u53F3\u306B\u4F38\u3073\u3066\u308B\u3001\u3001)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u5DE6\u53F3\u306E\u90E8\u5C4B\u3068\u3001\u3064\u306A\u304C\u3063\u3066\u308B\u306E\u304B\u3082\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u306A\u3089\u3001\u304A\u524D\u304C\u898B\u3066\u3053\u3044\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 2
    speakerName: 
    text: "\u30B7\u30B0\u30EB\u306F\uFF1F"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u3001\u3001\u4FFA\u306F\u3001\u3053\u3053\u3067\u6249\u3092\u898B\u5F35\u308B\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 5
    speakerName: 
    text: "(\u307E\u305F\u3001\u58C1\u306B\u3082\u305F\u308C\u3066\u308B\u3001\u3001\u75B2\u308C\u3066\u308B\u306E\u304B\u306A)"
