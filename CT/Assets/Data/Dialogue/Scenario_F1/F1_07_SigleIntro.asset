  lines:
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u4FFA\u306F\u30B7\u30B0\u30EB\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u306A\u305C\u3053\u3053\u306B\u3044\u308B\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u6570\u5E74\u524D\u306B\u51FA\u3066\u884C\u3063\u3061\u3083\u3063\u305F\u5BB6\u65CF\u3092\u3001\u63A2\u3057\u306B\u304D\u305F\u3093\u3060\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u305D\u3046\u304B\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u541B\u3053\u305D\u306A\u3093\u3067\u3053\u3093\u306A\u3068\u3053\u308D\u306B\uFF1F"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u3001\u3001\u3001\u5206\u304B\u3089\u306A\u3044\u3002\u6C17\u3065\u3044\u305F\u3089\u3053\u3053\u306B\u3044\u305F\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u4FFA\u306F\u3053\u3053\u3067\u4F55\u304B\u3001\u3057\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u4E8B\u304C\u3042\u308B\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u4E00\u756A\u5927\u4E8B\u306A\u3053\u3068\u3092\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u306A\u306E\u306B\u4F55\u3082\u899A\u3048\u3066\u3044\u306A\u3044\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u305D\u3063\u304B\u3001\u3001\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u304A\u524D\u306F\u3053\u3053\u3067\u4EBA\u3092\u63A2\u3059\u3093\u3060\u308D\u3046\u3002\u3053\u3053\u306F\u5371\u967A\u306A\u5974\u3089\u304C\u591A\u3044\u3001\u540C\u884C\u3057\u3088\u3046\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u3044\u3044\u306E\uFF1F\u3058\u3083\u3042\u30DC\u30AF\u3082\u541B\u306E\u5F79\u76EE\u3092\u601D\u3044\u51FA\u3059\u306E\u3092\u624B\u4F1D\u3046\u3088\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u3042\u3041\u3001\u884C\u304F\u305E"
