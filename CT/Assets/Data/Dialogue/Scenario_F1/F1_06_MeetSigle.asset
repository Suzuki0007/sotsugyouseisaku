    speakerName: "\uFF1F\uFF1F\uFF1F"
    text: "\u30FC\u30FC\u30FC\u30FC\u3002\u30FC\u30FC\u30FC\u30FC\uFF1F"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u4F55\u304B\u558B\u3063\u3066\u308B\uFF1F\u4F55\u304B\u8A00\u308F\u306A\u3044\u3068\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u30DC\u30AF\u306F\u30CE\u30A2\u3001\u52A9\u3051\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u30DC\u30AF\u8033\u304C\u805E\u3053\u3048\u306A\u304F\u3066\u3001\u4F55\u3092\u8A00\u3063\u3066\u308B\u304B\u5206\u304B\u3089\u306A\u3044\u3051\u308C\u3069\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: "\uFF1F\uFF1F\uFF1F"
    text: "\u3053\u308C\u3067\u3082\u304B\uFF1F"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "(\uFF01\uFF1F)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u3082\u3046\u305A\u3063\u3068\u524D\u304B\u3089\u805E\u3053\u3048\u306A\u3044\u306E\u306B\u306A\u3093\u3067\uFF01\uFF1F"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u3053\u3053\u306F\u5371\u306A\u3044\u3001\u7740\u3044\u3066\u3053\u3044\u3002"
