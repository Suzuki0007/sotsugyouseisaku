    text: "(\u3055\u3063\u304D\u8972\u3063\u3066\u304D\u305F\u3084\u3064\u3068\u540C\u3058\u82E6\u3057\u305D\u3046\u306B\u6253\u3061\u4ED8\u3051\u308B\u3088\u3046\u306A\u632F\u52D5\u3001\u3001\u307E\u308B\u3067\u6253\u697D\u5668\u3002\u3051\u3069\u3069\u3046\u898B\u3066\u3082\u6B63\u5E38\u306A\u97F3\u304C\u51FA\u305B\u308B\u3088\u3046\u306A\u72B6\u614B\u3058\u3083\u306A\u3044\u3002)"
