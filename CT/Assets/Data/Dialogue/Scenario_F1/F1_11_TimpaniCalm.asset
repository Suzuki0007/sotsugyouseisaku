    expression: 0
    speakerName: 
    text: "\uFF1F\uFF01\u6A5F\u68B0\u304C\u3057\u3083\u3079\u3063\u305F\u3001\u3001\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u304A\u4E3B\u306F\u3001\u3001\u30B7\u30B0\u30EB\u304B\u3002\u4E45\u3057\u3044\u306A\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u4FFA\u3092\u77E5\u3063\u3066\u3044\u308B\u306E\u304B\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u3042\u3041\u3001\u3082\u3061\u308D\u3093\u3060\u3068\u3082\u3002\u306A\u305C\u306A\u3089\u304A\u4E3B\u306F\u3053\u306E\u5854\u306E\u3001"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u3082\u3057\u304B\u3057\u3066\u304A\u4E3B\u899A\u3048\u3066\u304A\u3089\u3093\u306E\u304B"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u3001\u3001\u3001\u3042\u3041\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u305D\u3046\u304B\u3001\u3001\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u3068\u3053\u308D\u3067\u304A\u4E3B\u306F\u3001"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u30DC\u30AF\uFF1F\u30DC\u30AF\u306F\u30CE\u30A2\u3002\u4EBA\u3092\u63A2\u3057\u3066\u3044\u308B\u3093\u3060\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u3001\u3001\u3001\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u30CE\u30A2\u304B\u3001\u3044\u3044\u540D\u3060\u3002\u3042\u306E\u4EBA\u306B\u3088\u304F\u4F3C\u3066\u304A\u308B\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u4E0A\u306B\u5411\u304B\u3046\u306E\u3058\u3083\u308D\u3046\u3002\u6249\u306F\u958B\u3051\u3066\u3042\u308B\u3002\u3044\u3051\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30C6\u30A3\u30F3\u30D1\u30CB"
    text: "\u3053\u3053\u306B\u306F\u308F\u3057\u306E\u3088\u3046\u306B\u304A\u304B\u3057\u304F\u306A\u3063\u305F\u5974\u3089\u304C\u591A\u3044\u3002\u304F\u308C\u3050\u308C\u3082\u6C17\u3092\u3064\u3051\u3088\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
