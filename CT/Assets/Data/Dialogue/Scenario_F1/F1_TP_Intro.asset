    speakerName: "\uFF1F\uFF1F\uFF1F"
    text: "\u3001\u3001\u30B7\u30B0\u30EB\u3060\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u30DC\u30AF\u306F\u30CE\u30A2\u3002\u3088\u308D\u3057\u304F\u3001\u30B7\u30B0\u30EB\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u304A\u524D\u3001\u4F55\u3057\u306B\u6765\u305F\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 5
    speakerName: 
    text: "\u6570\u5E74\u524D\u306B\u51FA\u3066\u884C\u3063\u3061\u3083\u3063\u305F\u5BB6\u65CF\u3092\u3001\u63A2\u3057\u306B\u304D\u305F\u3093\u3060\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u3001\u3001\u305D\u306E\u592A\u9F13\u3001\u306A\u3093\u3067\u5206\u304B\u3063\u305F\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 5
    speakerName: 
    text: "\u5E2B\u5320\u306B\u3001\u6559\u308F\u3063\u305F\u304B\u3089\u3001\u3001"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u3042\u306E\u8857\u4E00\u756A\u306E\u8ABF\u5F8B\u5E2B\u3067\u3001\u30DC\u30AF\u306E\u5E2B\u5320\u306A\u3093\u3060\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
