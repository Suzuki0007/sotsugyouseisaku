    speakerName: 
    text: "\u3055\u3063\u304D\u306E\u5149\u3001\u3001\u30DC\u30AF\u304C\u89E6\u3063\u305F\u3068\u304D\u3060\u3051\u3060\u3063\u305F\u3002"
