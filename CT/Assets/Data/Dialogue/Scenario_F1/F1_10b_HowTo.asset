  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 4
    speakerName: 
    text: "\u30B7\u30B0\u30EB\u3001\u3053\u306E\u30C6\u30A3\u30F3\u30D1\u30CB\u3001\u30DA\u30B0\u304C\u3086\u308B\u3093\u3067\u308B\u3093\u3060\uFF01"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u5468\u308A\u306E\u8D64\u3044\u30DA\u30B0\u3092\u5168\u90E8\u7DE0\u3081\u3066\u8ABF\u5F8B\u3059\u308C\u3070\u3001\u304D\u3063\u3068\u5927\u4EBA\u3057\u304F\u306A\u308B\u3002\u30DA\u30B0\u306F\u30DC\u30AF\u304C\u7DE0\u3081\u308B\uFF01"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 0
    speakerName: 
    text: "\u308F\u304B\u3063\u305F\u3002\u304A\u524D\u306B\u98DB\u3093\u3067\u304F\u308B\u97F3\u306F\u3001\u4FFA\u304C\u9632\u3050\u3002"
  - character: {fileID: 11400000, guid: 1e130490a0c3e1c45886bec74eba2656, type: 2}
    expression: 5
    speakerName: 
    text: "\u3060\u304C\u3001\u9577\u304F\u306F\u3082\u305F\u306A\u3044\u3002\u843D\u3061\u3066\u304F\u308B\u5CA9\u306F\u81EA\u5206\u3067\u3088\u3051\u308D\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
