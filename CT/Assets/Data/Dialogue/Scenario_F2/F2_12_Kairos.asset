  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 1
    speakerName: 
    text: "\u30AB\u30A4\u30ED\u30B9\uFF01"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u30FC\u30FC\u30FC\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 3
    speakerName: 
    text: "(\uFF01\u3000\u305D\u3063\u304B\u3001\u30AB\u30A4\u30ED\u30B9\u306E\u58F0\u306F\u3082\u3046\u805E\u3053\u3048\u306A\u3044\u3093\u3060\u3063\u305F\u3002)"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u30B3\u30C4\u30B3\u30C4"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 4
    speakerName: 
    text: "\u3053\u308C\u306F\u3001\u30E2\u30FC\u30EB\u30B9\u4FE1\u53F7\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u5927\u304D\u304F\u306A\u3063\u305F\u306A\u300D"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 4
    speakerName: 
    text: "\uFF01"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 2
    speakerName: 
    text: "\u805E\u3053\u3048\u306A\u304F\u306A\u3063\u305F\u304B\u3089\u3063\u3066\u6368\u3066\u305F\u304F\u305B\u306B\u4ECA\u66F4\uFF01"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u6368\u3066\u305F\uFF1F\u305D\u3046\u304B\u3001\u305D\u3046\u601D\u308F\u305B\u3066\u3057\u307E\u3063\u3066\u3044\u305F\u306E\u304B\u3002\u4E8B\u60C5\u304C\u3042\u3063\u305F\u3093\u3060\u304C\u3001\u3059\u307E\u306A\u3044\u300D"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u3067\u3082\u3053\u3053\u306B\u6765\u305F\u306E\u306F\u304A\u524D\u306E\u305F\u3081\u306A\u3093\u3060\u3002\u300D"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 4
    speakerName: 
    text: "\u30DC\u30AF\u306E\u305F\u3081\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u3042\u3041\u3001\u8ABF\u5F8B\u5E2B\u306F\u5143\u3005\u3053\u306E\u5CF6\u3067\u751F\u307E\u308C\u305F\u7D44\u7E54\u3060\u3002\u305D\u306E\u4E2D\u306B\u306F\u7279\u6B8A\u306A\u8005\u305F\u3061\u3082\u3044\u305F\u3089\u3057\u3044\u3002\u300D"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u4E00\u822C\u7684\u306A\u8074\u529B\u304C\u9000\u5316\u3059\u308B\u4EE3\u308F\u308A\u306B\u97F3\u3068\u4F1A\u8A71\u3092\u3059\u308B\u8005\u305F\u3061\u3060\u300D"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u5F53\u6642\u5B64\u5150\u3060\u3063\u305F\u304A\u524D\u306E\u51FA\u81EA\u306F\u30AF\u30ED\u30C3\u30AF\u30F4\u30A7\u30A4\u30EB\u3067\u3044\u304F\u3089\u63A2\u3057\u3066\u3082\u7279\u5B9A\u3067\u304D\u306A\u304B\u3063\u305F\u3002\u3082\u3057\u304B\u3057\u305F\u3089\u3068\u601D\u3063\u3066\u6765\u3066\u307F\u305F\u304C\u3069\u3046\u3084\u3089\u5408\u3063\u3066\u3044\u308B\u3088\u3046\u3060\u306A\u3002\u300D"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 5
    speakerName: 
    text: "\u3001\u3001\u3001\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u305D\u3053\u306E\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC\u3068\u8A71\u305B\u305F\u304B\uFF1F\u5F7C\u5973\u306F\u97F3\u3001\u3064\u307E\u308A\u97F3\u697D\u6A5F\u69CB\u3060\u3002\u300D"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u3075\u3093\u3001\u305D\u306E\u8A00\u3044\u65B9\u306F\u6C17\u306B\u304F\u308F\u306A\u3044\u3051\u308C\u3069\u306D\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 3
    speakerName: 
    text: "\u3060\u304B\u3089\u30AB\u30A4\u30ED\u30B9\u306E\u58F0\u3060\u3051\u805E\u3053\u3048\u306A\u3044\u3001\u3001\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 3
    speakerName: 
    text: "\u3001\u3001\u3001\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30AB\u30A4\u30ED\u30B9"
    text: "\u300C\u5C11\u3057\u4E00\u6C17\u306B\u8A71\u3057\u3059\u304E\u305F\u304B\u3002\u75B2\u308C\u3066\u3044\u308B\u3060\u308D\u3046\u3001\u5C11\u3057\u4F11\u3081\u3002\u4FFA\u306F\u5C11\u3057\u51FA\u3066\u304F\u308B\u3002\u300D"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u308F\u304B\u3063\u305F\u3002"
