  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eac73eb13381b184b8a3fd1f6643eddc, type: 3}
  m_Name: F2_05_Velzy
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u307E\u305F\u6697\u53F7\u3001\u3053\u3053\u306B\u3044\u305F\u6614\u306E\u4EBA\u305F\u3061\u306F\u4EBA\u9593\u4E0D\u4FE1\u3060\u3063\u305F\u306E\u304B\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\uFF1F\uFF1F\uFF1F"
    text: "\u30C8\u30F3\u30C8\u30F3"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\uFF01\u8AB0\uFF01\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\uFF1F\uFF1F\uFF1F"
    text: "\u30FC\u30FC\u30FC\u30FC\uFF1F\u30FC\u30FC\u30FC\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u5C0F\u3055\u3044\u5973\u306E\u5B50\u3001\u3001\uFF1F\u306A\u3093\u3067\u3053\u3093\u306A\u3068\u3053\u308D\u306B\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\uFF1F\uFF1F\uFF1F"
    text: "\u30FC\u30FC\u30FC\u30FC\u30FC\u3002\u30FC\u30FC\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "(\u3084\u3063\u3071\u308A\u30B7\u30B0\u30EB\u4EE5\u5916\u306E\u58F0\u306F)"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u3042\u3044\u3064\u306E\u8A00\u3063\u3066\u305F\u901A\u308A\u306D\u3002\u3053\u306E\u8A71\u3057\u65B9\u306F\u75B2\u308C\u308B\u306E\u3060\u3051\u308C\u3069\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u3053\u306E\u5B50\u306E\u58F0\u3082\u805E\u3053\u3048\u308B\uFF1F\uFF01"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u541B\u306F\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u30EF\u30BF\u30B7\u306F\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC\u3088\u3002\u3053\u3053\u306E\u7BA1\u7406\u8005\u306E\u3088\u3046\u306A\u3082\u306E\u306D\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u304A\u524D\u304C\u3042\u3044\u3064\u306E\u8A00\u3063\u3066\u305F\u30CE\u30A2\u306D\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u3042\u3044\u3064\u3063\u3066\u3082\u3057\u304B\u3057\u3066\u30AB\u30A4\u30ED\u30B9\uFF1F\u672C\u5F53\u306B\u751F\u304D\u3066\u308B\u306E\uFF01\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u3048\u3048\u3002\u4E00\u756A\u512A\u79C0\u306A\u5F1F\u5B50\u304C\u6765\u308B\u3063\u3066\u8A00\u3063\u3066\u305F\u304B\u3089\u671F\u5F85\u3057\u3066\u3044\u305F\u306E\u3060\u3051\u308C\u3069\u3001\u3053\u3093\u306A\u306B\u5C0F\u3055\u3044\u306A\u3093\u3066\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\u5C0F\u3055\u3044\u306E\u306F\u541B\u3082"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u3046\u308B\u3055\u3044\u308F\u306D\u3001\u30EF\u30BF\u30B7\u306F\u304A\u524D\u306E\u4F55\u500D\u3082\u751F\u304D\u3066\u308B\u3057\u3044\u308D\u3093\u306A\u4E8B\u3092\u77E5\u3063\u3066\u3044\u308B\u306E\u3088\u3002"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u304A\u524D\u306B\u306F\u7D76\u5BFE\u306B\u5206\u304B\u3089\u306A\u3044\u307B\u3069\u306D\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "\uFF1F\u3000\u305D\u308C\u3088\u308A\u3082\u30AB\u30A4\u30ED\u30B9\u306F\uFF1F\u7121\u4E8B\u306A\u306E\uFF1F\u3069\u3053\u306B\u3044\u308B\uFF1F"
  - character: {fileID: 0}
    expression: 0
    speakerName: "\u30F4\u30A7\u30EB\u30C4\u30A3\u30FC"
    text: "\u3075\u3093\u3001\u30EF\u30BF\u30B7\u306B\u805E\u304B\u306A\u3044\u3067\u3002\u4F1A\u308F\u305B\u3066\u3084\u308B\u308F\u3088\u3002"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "(\u30AB\u30A4\u30ED\u30B9\u304C\u751F\u304D\u3066\u308B\u3001\u3001\uFF01\u3084\u3063\u3068\u4F1A\u3048\u308B\uFF01)"
