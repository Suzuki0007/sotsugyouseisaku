  lines:
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 3
    speakerName: 
    text: "(10\u6B73\u306E\u3042\u306E\u65E5\u304B\u3089\u3001\u30DC\u30AF\u306E\u8033\u306F\u97F3\u3092\u805E\u3051\u306A\u304F\u306A\u3063\u305F\u3002)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 5
    speakerName: 
    text: "(\u8857\u4E00\u756A\u306E\u8ABF\u5F8B\u5E2B\u3001\u30AB\u30A4\u30ED\u30B9\u306E\u5F1F\u5B50\u306A\u306E\u306B\u3002\u4ECA\u3058\u3083\u300C\u843D\u3061\u3053\u307C\u308C\u300D\u3060\u3002)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "(\u305D\u306E\u30AB\u30A4\u30ED\u30B9\u3082\u3001\u4F55\u5E74\u3082\u524D\u306B\u3044\u306A\u304F\u306A\u3063\u305F\u3002)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 4
    speakerName: 
    text: "(\u306A\u306E\u306B\u4ECA\u671D\u3001\u30AB\u30A4\u30ED\u30B9\u304B\u3089\u624B\u7D19\u304C\u5C4A\u3044\u305F\u3002)"
  - character: {fileID: 0}
    expression: 0
    speakerName: 
    text: "\u300C\u5C01\u5370\u306E\u5CF6\u3078\u6765\u3066\u304F\u308C\u3002\u5854\u3067\u5F85\u3063\u3066\u3044\u308B\u3002\u2015\u2015\u30AB\u30A4\u30ED\u30B9\u300D"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 5
    speakerName: 
    text: "(\u9418\u304C\u9CF4\u308C\u3070\u9858\u3044\u304C\u53F6\u3046\u5CF6\u3002\u3067\u3082\u3001\u884C\u3063\u3066\u5E30\u3063\u3066\u304D\u305F\u4EBA\u306F\u3044\u306A\u3044\u3002)"
  - character: {fileID: 11400000, guid: 5dd6beef385447d41b6fb1926a5d911e, type: 2}
    expression: 0
    speakerName: 
    text: "(\u3001\u3001\u3001\u305D\u308C\u3067\u3082\u3001\u884C\u304B\u306A\u304D\u3083\u3002)"
